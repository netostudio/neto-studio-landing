---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="mx-auto max-w-4xl px-6 pb-20 pt-24 text-center sm:pt-32">
  <span
    class="inline-flex items-center gap-2 rounded-full border border-white/10 px-3 py-1 text-xs font-medium uppercase tracking-wider text-muted"
  >
    <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
    {t.hero.badge}
  </span>

  <h1 class="mt-6 text-4xl font-bold tracking-tight text-paper sm:text-5xl md:text-6xl">
    {t.hero.title}
  </h1>

  <p class="mx-auto mt-6 max-w-2xl text-lg text-muted">
    {t.hero.subtitle}
  </p>

  <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
    <a
      href="#contact"
      class="w-full rounded-md bg-paper px-6 py-3 text-sm font-semibold text-ink transition-opacity hover:opacity-90 sm:w-auto"
    >
      {t.hero.ctaPrimary}
    </a>
    <a
      href="#audit-preview"
      class="w-full rounded-md border border-white/15 px-6 py-3 text-sm font-semibold text-paper transition-colors hover:border-white/30 hover:bg-white/5 sm:w-auto"
    >
      {t.hero.ctaSecondary}
    </a>
  </div>
</section>
