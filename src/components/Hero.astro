---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="mx-auto max-w-4xl px-6 pb-20 pt-24 text-center sm:pt-32">
  <h1 class="mt-0 text-4xl font-bold tracking-tight text-ink sm:text-5xl md:text-6xl">
    {t.hero.title}
  </h1>

  <p class="mx-auto mt-6 max-w-2xl text-lg text-muted">
    {t.hero.subtitle}
  </p>

  <div class="mt-16 flex flex-col items-center justify-center gap-4 sm:flex-row">
    <a
      href="#contact"
      class="w-full rounded-md bg-ink px-6 py-3 text-sm font-semibold text-paper transition-opacity hover:opacity-90 sm:w-auto"
    >
      {t.hero.ctaPrimary}
    </a>
    <a
      href="#audit-preview"
      class="w-full rounded-md border border-black/15 px-6 py-3 text-sm font-semibold text-ink transition-colors hover:border-black/30 hover:bg-black/5 sm:w-auto"
    >
      {t.hero.ctaSecondary}
    </a>
  </div>
</section>
