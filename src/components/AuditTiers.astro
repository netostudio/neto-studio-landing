---
import { Check } from '@lucide/astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { tiers } = t.auditPage;

// Service values must match the options of the contact form select. They keep
// the values of the former tiers so the Make scenario mapping does not change.
const items = [
  { ...tiers.systems, service: 'audit-check' },
  { ...tiers.software, service: 'audit-full' },
];
---

<!--
  On lg the cards share the parent grid rows through subgrid (one row per card
  section: header, price, includes, method, deliverables), so each section lines up
  across both cards regardless of how long its text is.
-->
<section id="tiers" class="mx-auto max-w-6xl px-6 py-16">
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-y-0">
    {
      items.map((tier) => (
        <div class="flex flex-col rounded-xl border border-black/10 bg-black/[0.02] p-8 lg:row-span-5 lg:grid lg:grid-rows-subgrid">
          <div>
            <p class="font-mono text-sm text-emerald-500">{tier.slug}</p>
            <h2 class="mt-2 text-xl font-semibold text-ink">{tier.name}</h2>
            <p class="mt-4 text-sm leading-relaxed text-muted">{tier.forWho}</p>
          </div>

          <div class="mt-6 border-t border-black/10 pt-6">
            <p class="text-2xl font-semibold text-ink">{tier.price}</p>
            <p class="text-xs text-muted">{tiers.priceNote}</p>
            <p class="mt-3 text-sm text-ink/90">
              <span class="font-medium">{tiers.timelineLabel}:</span> {tier.timeline}
            </p>
          </div>

          <div class="mt-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted">{tiers.includesLabel}</p>
            <ul class="mt-3 space-y-2.5">
              {tier.includes.map((item) => (
                <li class="flex items-start gap-2.5 text-sm text-ink/90">
                  <Check class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" stroke-width={2} />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-6 border-t border-black/10 pt-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted">{tiers.methodLabel}</p>
            <p class="mt-2 text-sm leading-relaxed text-ink/90">{tier.method}</p>
          </div>

          <div class="mt-6 flex flex-col border-t border-black/10 pt-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted">{tiers.deliverablesLabel}</p>
            <ul class="mt-3 flex-1 space-y-2.5">
              {tier.deliverables.map((item) => (
                <li class="flex items-start gap-2.5 text-sm text-ink/90">
                  <Check class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" stroke-width={2} />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <a
              href="#contact"
              data-service={tier.service}
              class="mt-6 block rounded-md bg-ink px-5 py-3 text-center text-sm font-semibold text-paper transition-opacity hover:opacity-90"
            >
              {tier.cta}
            </a>
          </div>
        </div>
      ))
    }
  </div>

  <div class="mt-6 rounded-xl border border-black/10 bg-black/[0.02] p-8">
    <h2 class="text-lg font-semibold text-ink">{tiers.boundary.title}</h2>
    <ul class="mt-4 space-y-2 text-sm leading-relaxed text-muted">
      {tiers.boundary.body.map((line) => <li>{line}</li>)}
    </ul>
  </div>
</section>
