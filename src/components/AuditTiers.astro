---
import { Check } from '@lucide/astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { tiers } = t.auditPage;

// Service values must match the options of the contact form select.
const items = [
  { ...tiers.check, service: 'audit-check', highlight: false },
  { ...tiers.full, service: 'audit-full', highlight: true },
  { ...tiers.diligence, service: 'audit-diligence', highlight: false },
];
---

<!--
  On lg the cards share the parent grid rows through subgrid (one row per card
  section: header, price, includes, deliverable), so each section lines up across
  the three cards regardless of how long its text is.
-->
<section id="tiers" class="mx-auto max-w-6xl px-6 py-16">
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3 lg:gap-y-0">
    {
      items.map((tier) => (
        <div
          class:list={[
            'relative flex flex-col rounded-xl border bg-black/[0.02] p-8 lg:row-span-4 lg:grid lg:grid-rows-subgrid',
            tier.highlight ? 'border-ink' : 'border-black/10',
          ]}
        >
          {tier.highlight && (
            <span class="absolute -top-3 left-8 rounded-full bg-ink px-3 py-1 text-xs font-semibold text-paper">
              {tiers.highlightLabel}
            </span>
          )}
          <div>
            <p class="font-mono text-sm text-emerald-500">{tier.slug}</p>
            <h2 class="mt-2 text-xl font-semibold text-ink">{tier.name}</h2>
            <p class="mt-4 text-sm leading-relaxed text-muted">{tier.forWho}</p>
          </div>

          <div class="mt-6 border-t border-black/10 pt-6">
            <p class="text-2xl font-semibold text-ink">{tier.price}</p>
            <p class="text-xs text-muted">{tiers.priceNote}</p>
            <p class="mt-3 text-sm text-ink/90">
              <span class="font-medium">{tiers.timelineLabel}:</span> {tier.timeline}
            </p>
          </div>

          <div class="mt-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted">{tiers.includesLabel}</p>
            <ul class="mt-3 space-y-2.5">
              {tier.includes.map((item) => (
                <li class="flex items-start gap-2.5 text-sm text-ink/90">
                  <Check class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" stroke-width={2} />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-6 flex flex-col border-t border-black/10 pt-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted">{tiers.deliverableLabel}</p>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink/90">{tier.deliverable}</p>
            <a
              href="#contact"
              data-service={tier.service}
              class="mt-6 block rounded-md bg-ink px-5 py-3 text-center text-sm font-semibold text-paper transition-opacity hover:opacity-90"
            >
              {tier.cta}
            </a>
          </div>
        </div>
      ))
    }
  </div>
</section>
