---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import RiskBadge from './RiskBadge.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="audit-preview" class="mx-auto max-w-6xl px-6 py-24">
  <div class="mx-auto max-w-2xl text-center">
    <span class="text-xs font-semibold uppercase tracking-wider text-emerald-500">
      {t.auditPreview.badge}
    </span>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-paper sm:text-4xl">
      {t.auditPreview.title}
    </h2>
    <p class="mt-4 text-muted">{t.auditPreview.subtitle}</p>
  </div>

  <div class="mt-14 overflow-hidden rounded-xl border border-white/10 bg-white/[0.02]">
    <div class="border-b border-white/10 px-6 py-4">
      <h3 class="text-sm font-semibold text-paper">{t.auditPreview.riskMatrixTitle}</h3>
    </div>
    <div class="divide-y divide-white/10">
      {
        t.auditPreview.risks.map((risk) => (
          <div class="flex flex-col gap-3 px-6 py-5 sm:flex-row sm:items-center">
            <div class="sm:w-32">
              <RiskBadge level={risk.level} />
            </div>
            <p class="flex-1 text-sm text-paper/90">{risk.finding}</p>
            <p class="text-sm text-muted sm:w-72 sm:shrink-0">
              <span class="font-medium text-paper/70">{t.auditPreview.riskMatrixActionLabel}:</span>{' '}
              {risk.action}
            </p>
          </div>
        ))
      }
    </div>
  </div>

  <div class="mt-6 overflow-hidden rounded-xl border border-white/10 bg-white/[0.02]">
    <div class="border-b border-white/10 px-6 py-4">
      <h3 class="text-sm font-semibold text-paper">{t.auditPreview.roadmapTitle}</h3>
    </div>
    <div class="grid grid-cols-1 divide-y divide-white/10 sm:grid-cols-2 sm:divide-x sm:divide-y-0">
      {
        t.auditPreview.roadmap.map((phase) => (
          <div class="px-6 py-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-emerald-500">{phase.period}</p>
            <p class="mt-1 text-base font-medium text-paper">{phase.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
