---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const scheduleHref = import.meta.env.PUBLIC_CALENDLY_URL;
const privacyHref = getRelativeLocaleUrl(lang, 'privacy');
---

<section id="contact" class="mx-auto max-w-3xl px-6 py-24">
  <div class="text-center">
    <span class="text-xs font-semibold uppercase tracking-wider text-emerald-500">
      {t.contact.badge}
    </span>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">{t.contact.title}</h2>
    <p class="mt-4 text-muted">{t.contact.subtitle}</p>

    {
      scheduleHref && (
        <p class="mt-4 text-sm text-muted">
          {t.contact.scheduleNote}{' '}
          <a href={scheduleHref} class="font-medium text-ink underline underline-offset-4">
            {t.contact.scheduleCta}
          </a>
        </p>
      )
    }
  </div>

  <!--
    Submits to /api/contact, which nginx proxies to the Make webhook (see nginx.conf.template).
    Make creates the lead in Holded and sends the notification email.
  -->
  <form
    id="contact-form"
    action="/api/contact"
    method="post"
    class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2"
    data-sending={t.contact.sending}
    data-success={t.contact.status.success}
    data-error={t.contact.status.error}
    data-rate-limited={t.contact.status.rateLimited}
  >
    <input type="hidden" name="lang" value={lang} />
    <div class="flex flex-col gap-2">
      <label for="name" class="text-sm font-medium text-ink">{t.contact.fields.name}</label>
      <input
        id="name"
        name="name"
        type="text"
        required
        class="rounded-md border border-black/15 bg-black/[0.02] px-4 py-3 text-sm text-ink placeholder:text-muted/60 focus:border-black/30 focus:outline-none"
      />
    </div>

    <div class="flex flex-col gap-2">
      <label for="email" class="text-sm font-medium text-ink">{t.contact.fields.email}</label>
      <input
        id="email"
        name="email"
        type="email"
        required
        class="rounded-md border border-black/15 bg-black/[0.02] px-4 py-3 text-sm text-ink placeholder:text-muted/60 focus:border-black/30 focus:outline-none"
      />
    </div>

    <div class="flex flex-col gap-2 sm:col-span-2">
      <label for="role" class="text-sm font-medium text-ink">{t.contact.fields.role}</label>
      <select
        id="role"
        name="role"
        required
        class="rounded-md border border-black/15 bg-black/[0.02] px-4 py-3 text-sm text-ink focus:border-black/30 focus:outline-none"
      >
        <option value="" selected disabled>{t.contact.fields.rolePlaceholder}</option>
        {t.contact.fields.roleOptions.map((role) => <option value={role}>{role}</option>)}
      </select>
    </div>

    <div class="flex flex-col gap-2 sm:col-span-2">
      <label for="message" class="text-sm font-medium text-ink">{t.contact.fields.message}</label>
      <textarea
        id="message"
        name="message"
        rows="5"
        required
        class="resize-none rounded-md border border-black/15 bg-black/[0.02] px-4 py-3 text-sm text-ink placeholder:text-muted/60 focus:border-black/30 focus:outline-none"
      ></textarea>
    </div>

    <label class="flex items-start gap-3 text-sm text-muted sm:col-span-2">
      <input
        id="privacy"
        name="privacy"
        type="checkbox"
        value="accepted"
        required
        class="mt-0.5 h-4 w-4 shrink-0 accent-ink"
      />
      <span>
        {t.contact.fields.privacyConsent}{' '}
        <a href={privacyHref} class="font-medium text-ink underline underline-offset-4">
          {t.contact.fields.privacyLink}
        </a>
      </span>
    </label>

    <button
      type="submit"
      class="rounded-md bg-ink px-6 py-3 text-sm font-semibold text-paper transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60 sm:col-span-2"
    >
      {t.contact.submit}
    </button>

    <p id="contact-status" role="status" aria-live="polite" class="hidden text-sm sm:col-span-2"></p>
  </form>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLParagraphElement>('#contact-status');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  function showStatus(message: string, ok: boolean) {
    if (!status) return;
    status.textContent = message;
    status.classList.remove('hidden', 'text-emerald-500', 'text-crimson');
    status.classList.add(ok ? 'text-emerald-500' : 'text-crimson');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!button) return;

    const { sending = '', success = '', error = '', rateLimited = '' } = form.dataset;
    const submitLabel = button.textContent;
    button.disabled = true;
    button.textContent = sending;
    status?.classList.add('hidden');

    try {
      const body = new URLSearchParams();
      new FormData(form).forEach((value, key) => body.append(key, String(value)));
      const res = await fetch(form.action, { method: 'POST', body });

      if (res.ok) {
        form.reset();
        showStatus(success, true);
      } else {
        showStatus(res.status === 429 ? rateLimited : error, false);
      }
    } catch {
      showStatus(error, false);
    } finally {
      button.disabled = false;
      button.textContent = submitLabel;
    }
  });
</script>
