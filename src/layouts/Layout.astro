---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/utils';
import { languages } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title = t.meta.title, description = t.meta.description, noindex = false } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogLocaleMap: Record<string, string> = { en: 'en_US', es: 'es_ES' };
// Supplied as static files in public/ (1200x630), one per language because
// the image carries the hero claim.
const ogImageFile: Record<string, string> = { en: '/og-image.png', es: '/og-image-es.png' };
const ogImageURL = new URL(ogImageFile[lang], Astro.site);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'neto.studio',
  url: Astro.site?.href,
  logo: new URL('/neto-logo.svg', Astro.site).href,
  image: ogImageURL.href,
  email: 'info@neto.studio',
  description: t.meta.description,
  inLanguage: lang,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    {
      Object.keys(languages).map((locale) => (
        <link
          rel="alternate"
          hreflang={locale}
          href={new URL(getLocalizedPath(Astro.url, locale as keyof typeof languages), Astro.site)}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(getLocalizedPath(Astro.url, 'en'), Astro.site)}
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="neto.studio" />
    <meta property="og:locale" content={ogLocaleMap[lang]} />
    {
      Object.keys(languages)
        .filter((locale) => locale !== lang)
        .map((locale) => <meta property="og:locale:alternate" content={ogLocaleMap[locale]} />)
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <slot />
  </body>
</html>
