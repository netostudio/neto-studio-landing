# Local Cloudflare Workers runtime: serves the static build and runs the
# Worker (worker/index.ts) with `wrangler dev`, using the same wrangler.jsonc
# as production. Debian based because workerd (wrangler's runtime) does not
# run on alpine/musl.
FROM node:24-bookworm-slim

# The slim image has no root certificates, which workerd needs for HTTPS
# requests (the Worker calls the Make webhook).
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

# wrangler is installed here and not in package.json on purpose: when the
# project depended on it, the Cloudflare build mixed the project's esbuild
# with the one from its own toolchain and failed ("Host version ... does not
# match binary version ...").
RUN npm install -g wrangler@4.86.0

ENV WRANGLER_SEND_METRICS=false

EXPOSE 8788

# Builds from the mounted source on every start, so `make restart` serves the
# current code. wrangler reads MAKE_WEBHOOK_* from the mounted .env by itself;
# never pass them as command line arguments, they would end up in logs. If
# they are missing the site still runs and /api/contact answers 500.
# wrangler is exec'd directly (not through npx) so it receives SIGTERM.
CMD ["sh", "-c", "npm run build && exec wrangler dev --ip 0.0.0.0 --port 8788"]
