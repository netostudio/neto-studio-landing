# Scheduling URL (Calendly, Cal.com, etc.) used by the "Schedule Diagnostic" CTAs.
# If left empty, those CTAs scroll to the contact section (#contact) as a fallback.
PUBLIC_CALENDLY_URL=

# Contact form: Make webhook that receives submissions (creates the lead in
# Holded and sends a notification to Slack). Runtime secrets: in production
# they are Cloudflare Worker secrets read by worker/index.ts; locally the
# worker service and the `astro dev` proxy read them from here. Never prefix
# them with PUBLIC_.
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_APIKEY=
