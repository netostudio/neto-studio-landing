# Scheduling URL (Calendly, Cal.com, etc.) used by the "Schedule Diagnostic" CTAs.
# If left empty, those CTAs scroll to the contact section (#contact) as a fallback.
PUBLIC_CALENDLY_URL=

# Contact form: Make webhook that receives submissions (creates the lead in
# Holded and sends the notification email). Runtime secrets: nginx injects
# them when the production container starts, and `astro dev` uses them for its
# local /api/contact proxy. Never prefix them with PUBLIC_.
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_APIKEY=
