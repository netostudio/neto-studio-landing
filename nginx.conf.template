# Rendered at container start by the official nginx image (envsubst on
# /etc/nginx/templates/*.template). Only variables present in the environment
# are substituted, so nginx's own variables ($uri, etc.) are left untouched.
# Required at runtime: MAKE_WEBHOOK_URL, MAKE_WEBHOOK_APIKEY. If either is
# missing, nginx refuses to start instead of serving a broken contact form.

# Per-IP rate limit for the contact form proxy. This file is included inside
# the http context, so the zone can be declared here. If a proxy or CDN is put
# in front of this container, configure real_ip_header/set_real_ip_from so the
# limit applies to the visitor's IP instead of the proxy's.
limit_req_zone $binary_remote_addr zone=contact:10m rate=3r/m;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml font/woff2;
    gzip_min_length 1024;

    # Astro static build: /privacy resolves to /privacy/index.html.
    # $uri/index.html is checked before $uri/ so nginx serves the file
    # directly instead of issuing a directory redirect (which drops the
    # port when not running behind a reverse proxy on a standard port).
    # All pages are served as clean URLs (no .html suffix), so revalidate
    # on every request here so deploys show up immediately.
    location / {
        try_files $uri $uri/index.html $uri/ =404;
        add_header Cache-Control "no-cache";
    }

    # Hashed, content-addressed assets (JS/CSS/fonts) - safe to cache forever.
    # More specific than location /, so it overrides the header above.
    location /_astro/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Contact form: forwards submissions to the Make webhook, adding the
    # webhook API key server-side so neither the URL nor the key reach the
    # browser.
    location = /api/contact {
        limit_except POST {
            deny all;
        }
        client_max_body_size 16k;

        limit_req zone=contact burst=2 nodelay;
        limit_req_status 429;

        proxy_set_header x-make-apikey "${MAKE_WEBHOOK_APIKEY}";
        proxy_set_header Cookie "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_ssl_server_name on;
        proxy_pass ${MAKE_WEBHOOK_URL};

        add_header Cache-Control "no-store";
    }
}
